<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline checks of runCode's compiler (ScriptCompiler): default usings,
    line mapping, hoisted using directives and the read-mode guard, compiled
    against the Civil 3D reference assemblies and the built plugin; and of its
    AutoCAD-free runtime helpers (RunCodeOutput, RpcAuth, HostDispatchState: RuntimeChecks.cs;
    HostInputRoute: HostRouteChecks.cs).
    Nothing runs in Civil 3D. Usage: see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Civil3D-MCP-Plugin\ScriptCompiler.cs" Link="ScriptCompiler.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeOutput.cs" Link="RunCodeOutput.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeHelpers.cs" Link="RunCodeHelpers.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeChanges.cs" Link="RunCodeChanges.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeArguments.cs" Link="RunCodeArguments.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\HostDispatchState.cs" Link="HostDispatchState.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\HostInputRoute.cs" Link="HostInputRoute.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeLog.cs" Link="RunCodeLog.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeResult.cs" Link="RunCodeResult.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RunCodeJson.cs" Link="RunCodeJson.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RpcAuth.cs" Link="RpcAuth.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\InstanceDiscovery.cs" Link="InstanceDiscovery.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\InstancePortBinder.cs" Link="InstancePortBinder.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\ComRegistration.cs" Link="ComRegistration.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\IdleDeadline.cs" Link="IdleDeadline.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\PdfOutputInspector.cs" Link="PdfOutputInspector.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RasterPlot.cs" Link="RasterPlot.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\DbmodFlags.cs" Link="DbmodFlags.cs" />
  </ItemGroup>
</Project>
